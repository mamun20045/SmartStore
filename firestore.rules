rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Primary admin email (case-insensitive)
      let isEmailAdmin = isSignedIn() && request.auth.token.email.lower() == 'chinaonlinebdpurchase2@gmail.com';
      // Specific UID as fallback
      let isIdAdmin = isSignedIn() && request.auth.uid == 'Sl4zsHpVgqVOEVpWYx3Cl4DvydE2';
      return isEmailAdmin || isIdAdmin;
    }

    function isValidProduct(data) {
      // Basic validation: must have name and price
      return data.name is string && data.name.size() > 0
        && data.price is string;
    }

    // Products: Full access for management
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // Keeping open but being explicit for deletion
    }

    // Settings: Full access
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Clicks: Full access
    match /clicks/{clickId} {
      allow read, write: if true;
    }

    // Analytics: Visitors can update stats, admins can read
    match /analytics_geo/{countryCode} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}
